# ---- REQUIRED ----

# Gmail address that sends the notification emails (your own main Gmail).
# Note: the recipient sees this address as the sender.
GMAIL_USER=Muntazimalam123456@gmail.com

# Gmail App Password (16 chars) - enable 2-Step Verification on the account,
# then Google Account > Security > App passwords > create one for "Mail".
GMAIL_APP_PASSWORD=your_16_char_app_password

# Secret token used to read stored submissions: /api/admin?token=<here>
ADMIN_TOKEN=change_me_to_a_long_random_string

# Where to deliver each submission (defaults to GMAIL_USER when empty)
NOTIFY_TO=Muntazimalam123456@gmail.com

# ---- OPTIONAL ----

# File that stores submissions (plain .jsonl text, one record per line)
DATA_FILE=submissions.jsonl

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://muntazimalam.github.io,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8899,http://127.0.0.1:8899